{
  "name": "darons",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-service-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/build-service-worker.mjs",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "ci": "npm run lint && npm run type-check && npm run test",
    "analyze": "ANALYZE=true next build",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --local > src/types/database.ts",
    "db:migration": "npx supabase migration new"
  },
